---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import NewsSection from "../components/NewsSection.astro";
import ResearchSection from "../components/ResearchSection.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title={`${profile.nameJa} | Researcher Homepage`}
  description="センシングとAIで、実世界を理解し、働きかける。屋内測位・空間センシング、建物インテリジェンス、LLM、強化学習に取り組む研究者の個人ホームページです。"
>
  <SiteHeader />
  <main>
    <Hero />
    <NewsSection />
    <ResearchSection />
  </main>
  <Footer />
</BaseLayout>
